# Required for local article copy and image-prompt generation.
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key

# Required for local cover image generation (Gemini / Nano Banana — gemini-2.5-flash-image).
GEMINI_API_KEY=your-gemini-api-key

# Optional: only if AUTO_BLOG_TEXT_PROVIDER=openai
# OPENAI_API_KEY=sk-your-openai-api-key

# Local development defaults.
AUTO_BLOG_MODE=once
AUTO_BLOG_DRY_RUN=true
AUTO_BLOG_TEXT_PROVIDER=anthropic
AUTO_BLOG_TEXT_MODEL=claude-haiku-4-5
AUTO_BLOG_PROMPT_VERSION=v2
AUTO_BLOG_AUTHOR=Element Armory Team
# Cap structured SVG diagrams per article (LLM output truncated to this).
AUTO_BLOG_MAX_DIAGRAMS=3

# Used by npm run generate:local when testing images locally.
# Keep AUTO_BLOG_DRY_RUN=true if you want the normal npm run dev command to stay preview-only.

# Optional local paths. Defaults write state under auto-blogger/data.
# AUTO_BLOG_STATE_PATH=./data/auto-blogger-state.json
# AUTO_BLOG_LOCK_PATH=./data/auto-blogger.lock

# Image generation is skipped during dry runs. For non-dry-run, configure these.
# Default model is Gemini 2.5 Flash Image (Nano Banana). Alternatives: gemini-3.1-flash-image-preview (Nano Banana 2), gemini-3-pro-image-preview (Nano Banana Pro).
AUTO_BLOG_IMAGE_MODEL=gemini-2.5-flash-image
AUTO_BLOG_IMAGE_PALETTE=vibrant
AUTO_BLOG_IMAGE_SIZE=1536x1024
# AUTO_BLOG_IMAGE_QUALITY is legacy (OpenAI); unused for Gemini.
AUTO_BLOG_IMAGE_QUALITY=auto
AUTO_BLOG_IMAGE_FORMAT=png
AUTO_BLOG_ALLOW_IMAGE_FALLBACK=true
# Resolution tier for Gemini 3.x image models only (e.g. 1K, 2K, 4K, or 512 where supported).
# AUTO_BLOG_GEMINI_IMAGE_SIZE=1K

# Skip topics that already have markdown under website/content/topics (default). Set to true to ignore on-disk articles.
# AUTO_BLOG_ALLOW_TOPIC_OVERWRITE=false

# Import from S3 refuses to overwrite existing article paths unless true.
# AUTO_BLOG_IMPORT_OVERWRITE=false

# Production upload/email settings. Leave unset for local dry runs.
# AUTO_BLOG_S3_BUCKET=
# AUTO_BLOG_S3_PREFIX=auto-blogger
# AUTO_BLOG_NOTIFY_TO=
# AUTO_BLOG_NOTIFY_FROM=
# AUTO_BLOG_REQUIRE_EMAIL=false

# Daemon mode settings.
DAILY_ARTICLES=1
AUTO_BLOG_TIMEZONE=Australia/Sydney
AUTO_BLOG_MIN_GAP_MINUTES=120
# News cycle settings.
# AUTO_BLOG_NEWS_CYCLE_ENABLED=false
# AUTO_BLOG_NEWS_CYCLE_HOUR=10
# AUTO_BLOG_NEWS_RECENCY_HOURS=168
# AUTO_BLOG_NEWS_MIN_ITEMS=3
