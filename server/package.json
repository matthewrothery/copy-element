{
  "name": "element-armory-server",
  "version": "0.1.0",
  "description": "Element Armory API and MCP backend",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "migrate": "tsx src/db/migrate.ts",
    "migrate:prod": "node dist/db/migrate.js",
    "migrate:create": "tsx src/db/migrate-create.ts"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1009.0",
    "@aws-sdk/client-ses": "^3.1009.0",
    "@aws-sdk/s3-request-presigner": "^3.1009.0",
    "@react-email/components": "^1.0.9",
    "@react-email/render": "^2.0.4",
    "better-auth": "^1.5.5",
    "better-sqlite3": "^12.0.0",
    "chalk": "^5.3.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "morgan": "^1.10.0",
    "nanoid": "^5.0.9",
    "stripe": "^17.5.0",
    "react": "^19.2.4",
    "react-email": "^5.2.9"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/morgan": "^1.9.9",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.14",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
