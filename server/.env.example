# Server
NODE_ENV=development
PORT=3000

# Database (SQLite). Path relative to cwd or absolute.
DATABASE_PATH=./data/element-armory.db

# Better Auth (min 32 chars for secret)
BETTER_AUTH_SECRET=
# In Docker (see root docker-compose.yml) use the host-visible API URL, e.g. http://localhost:3001
BETTER_AUTH_URL=http://localhost:3000
# When the frontend (e.g. Next.js) is on a different host, set this so post-login redirect is allowed (trustedOrigins).
# Example: http://localhost:8888 or https://elementarmory.com
FRONTEND_URL=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AWS SES (magic link emails)
AWS_SES_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
FROM_EMAIL=noreply@example.com

# Future phases
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# S3_BUCKET=
# S3_REGION=
