# Server
NODE_ENV=development
PORT=80

# Database (SQLite). Path relative to cwd or absolute.
DATABASE_PATH=./data/element-armory.db

# Better Auth (min 32 chars for secret)
BETTER_AUTH_SECRET=
# In Docker (see root docker-compose.yml) use the host-visible API URL, e.g. http://localhost:3001
BETTER_AUTH_URL=http://localhost:8840
# When the frontend (e.g. Next.js) is on a different host, set this so post-login redirect is allowed (trustedOrigins).
# Example: http://localhost:9900 or https://elementarmory.com
FRONTEND_URL=http://localhost:9900

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AWS SES (magic link emails)
AWS_SES_REGION=us-east-2
# AWS credentials are injected from root .env via docker-compose.yml — set them there, not here.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
FROM_EMAIL=noreply@elementarmory.com
SUPPORT_EMAIL=support@elementarmory.com

# Stripe (Phase 3)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_SUCCESS_URL=http://localhost:3000/account?checkout=success
STRIPE_CANCEL_URL=http://localhost:3000/billing
STRIPE_PORTAL_RETURN_URL=http://localhost:3000/account

# S3 (Phase 4)
# S3_REGION=
# S3_BUCKET_CAPTURES=
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY used for S3 when set
# S3_ENDPOINT= (optional, for MinIO etc.)
# S3_FORCE_PATH_STYLE= (optional)

# MCP server (Phase 6)
# Shared secret between server and mcp-server (min 32 chars)
INTERNAL_API_KEY=
# Anthropic API key for AI component conversion
ANTHROPIC_API_KEY=

# Admin dashboard
# Origin of the admin SPA (Better Auth trustedOrigins). In NODE_ENV=development the default is
# http://localhost:9920 (host port from start.sh / docker-compose). Override if you use another port.
# ADMIN_ORIGIN=https://admin.elementarmory.com
# Absolute path to internal-tools directory (for blog generator)
# Example: /home/ec2-user/element-armory/internal-tools
INTERNAL_TOOLS_PATH=

# Comma-separated emails that are auto-promoted to admin on startup / sign-up
ADMIN_EMAILS=
