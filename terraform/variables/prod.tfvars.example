# Element Armory / element-armory Production Terraform Variables
# Copy this file to prod.tfvars and fill in your values
# DO NOT commit prod.tfvars to git!

project     = "element-armory"
environment = "prod"
aws_region  = "us-east-2"

# Domain configuration
hosted_zone    = "elementarmory.com"
website_domain = "elementarmory.com"
app_domain     = "app.elementarmory.com"

# VPC configuration
main_vpc_cidr = "10.0.0.0/22"

# Database configuration
db_user           = "element_armory_user"
db_name           = "element_armory"
db_instance_class = "db.t4g.micro"
db_engine_type    = "postgres"
db_engine_version = "17.6"
# Leave empty to auto-generate password
db_password = ""

# EC2 configuration
ec2_instance_type = "t3.small"
ec2_key_pair_name = ""

# ECR repository name
ecr_server_repo = "element-armory-server"
ecr_auto_blogger_repo = "element-armory-auto-blogger"
enable_auto_blogger_lambdas = false
# Keep automatic topic/news generation paused until editorial review is restored.
enable_auto_blogger_schedules = false

# S3 bucket names
s3_website_bucket = "elementarmory.com"
# s3_assets_bucket_base is optional; default "element-armory-assets" → bucket element-armory-assets-prod
# s3_auto_blog_bucket_base is optional; default "element-armory-auto-blog" → bucket element-armory-auto-blog-prod

# Application secrets (fill these in!)
session_secret = "your-session-secret-here"
cookie_secret  = "your-cookie-secret-here"

# Google OAuth (Better Auth). Authorized redirect URI in Google Cloud Console:
# https://<website_domain>/api/auth/callback/google
google_client_id     = ""
google_client_secret = ""
gemini_api_key       = ""
openai_api_key       = ""
auto_blog_notify_to  = "support@elementarmory.com"
admin_summary_email  = "hello@elementarmory.com"
admin_summary_hour   = 8

# Optional: Your local IP for database access (if needed)
local_ip = ""

# Optional: Domain verification (leave empty to skip)
# search_console_txt = ""
# gmail_txt = ""
# gmail_mx = "smtp.google.com" # or "smtp.google.com." — trailing dot is optional
# gmail_mx_priority = 1
# gmail_dkim_txt = "v=DKIM1; k=rsa; p=MIIB..." # Google Admin → Apps → Gmail → Authenticate email → DKIM
