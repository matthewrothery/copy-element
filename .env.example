# Docker Compose / start.sh
# Copy to .env and set values as needed.

# Host ports (browser uses these)
SERVER_PORT=8840
WEBSITE_PORT=9900

# Server (Better Auth, etc.). In Docker, BETTER_AUTH_URL is set from SERVER_PORT.
# Set BETTER_AUTH_SECRET (min 32 chars) for auth to work.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AWS SES magic link emails (optional)
AWS_SES_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
FROM_EMAIL=noreply@example.com

# LocalStack (local development) — uncomment to use LocalStack instead of real AWS
# AWS_ACCESS_KEY_ID=test
# AWS_SECRET_ACCESS_KEY=test
# AWS_SES_REGION=us-east-2
