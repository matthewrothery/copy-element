MCP_PORT=3001
# In Docker: http://server  |  Local dev: http://localhost:3000 (or whatever port server runs on)
MAIN_SERVER_URL=http://localhost:3000
# Must match INTERNAL_API_KEY in server/.env (min 32 chars random)
INTERNAL_API_KEY=
# Anthropic API key — get from console.anthropic.com
ANTHROPIC_API_KEY=
